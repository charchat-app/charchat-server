# ---- Postgres (docker compose) ----
# 복사: cp .env.example .env  후 값 변경 (.env는 git에 올리지 않는다)
POSTGRES_USER=charchat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=charchat
POSTGRES_PORT=5432

# ---- App ----
APP_NAME=charchat-server
API_PREFIX=/api/v1
# 앱이 쓰는 DB. 드라이버는 psycopg 3. 로컬 Docker 또는 팀 공용 DB 주소를 넣는다.
# 비밀번호의 @ : / # % 등은 URL 인코딩한다(예: @ → %40).
DATABASE_URL=postgresql://charchat:change-me@127.0.0.1:5432/charchat
# pytest 전용 DB. 이름이 _test로 끝나야 한다(테스트가 스키마를 지우고 app/db/schema.sql로 다시 만든다).
# 공용 DB를 가리키지 않는다. 로컬 Docker DB를 쓰며, 없으면 테스트가 같은 서버에 자동 생성한다.
TEST_DATABASE_URL=postgresql://charchat:change-me@127.0.0.1:5432/charchat_test
# 브라우저(Expo 웹)에서 API를 부를 수 있는 출처. JSON 배열로 적는다.
CORS_ORIGINS=["http://localhost:8081"]
# 업로드 이미지 저장 폴더(로컬 디스크). 공용 DB를 쓸 때는 다른 사람 PC의 파일을 열 수 없으니
# 이미지 기능은 각자 로컬 DB로 확인한다.
MEDIA_ROOT=media
# 연결 없는 이미지를 정리하기 전 유예 시간(시간). 정리: python -m app.features.creation.images.cleanup
IMAGE_CLEANUP_GRACE_HOURS=24
# ---- 대화 응답 생성 (CHAT-US-02) ----
# 공급자: fake(기본, 네트워크 없는 가짜 응답) 또는 openai_compatible(실제 호출).
# 호출 모델은 세션의 selected_model_id(models 행)다. fake는 provider_model_id를 이름표로만 쓴다.
# openai_compatible은 provider='openai' 모델을 {CHAT_LLM_BASE_URL}/chat/completions로 호출한다.
CHAT_LLM_PROVIDER=fake
# openai_compatible일 때만 사용. 기본 https://api.openai.com/v1.
# 키는 .env나 배포 환경변수에만 두고 커밋하지 않는다.
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_API_KEY=
# 모델 ID 앞에 붙일 말(선택). OpenRouter를 쓸 때는 BASE_URL=https://openrouter.ai/api/v1,
# 이 값을 openai/ 로 둔다(DB의 gpt-6-luna → openai/gpt-6-luna). OpenAI 직접 호출은 비워 둔다.
CHAT_LLM_MODEL_PREFIX=
# 새 세션 시작 때 selected_model_id로 고정할 기본 모델의 models.name(기본 루나).
# 해당 이름의 models 행이 없으면 세션 시작이 503 CONVERSATION_MODEL_NOT_CONFIGURED로 실패한다.
CHAT_DEFAULT_MODEL_NAME=루나
CHAT_LLM_TIMEOUT_SECONDS=60
# thread(기본): 별도 스레드에서 생성. inline: 요청 안에서 끝까지 생성(테스트용).
CHAT_GENERATION_WORKER=thread
# 스트리밍 원문 DB 기록 최소 간격(ms)과, 갱신이 멈춘 생성을 실패로 보는 시간(초).
CHAT_STREAM_FLUSH_MS=100
CHAT_GENERATION_STALE_SECONDS=180
# fake 공급자 조각 지연(ms)과 강제 실패(none/before/after). 입력에 #fail-before/#fail-after를
# 넣어도 해당 요청만 실패를 흉내 낸다(fake 전용).
CHAT_FAKE_CHUNK_DELAY_MS=30
CHAT_FAKE_FAIL_MODE=none
