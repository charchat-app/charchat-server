# ---- Postgres (docker compose) ----
# 복사: cp .env.example .env  후 값 변경 (.env는 git에 올리지 않는다)
POSTGRES_USER=charchat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=charchat
POSTGRES_PORT=5432

# ---- App ----
APP_NAME=charchat-server
API_PREFIX=/api/v1
# POSTGRES_* 값과 맞춘다. 드라이버는 DB 설정 확정 시 정한다.
DATABASE_URL=postgresql://charchat:change-me@localhost:5432/charchat
